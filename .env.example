# Copy to .env (never commit .env)
# Local default is SQLite. For Supabase use its Postgres connection string:
# DATABASE_URL=postgresql+psycopg://postgres.<project>:<password>@<host>:6543/postgres
ADMIN_TOKEN=change-me-to-a-long-random-string
DEFAULT_RECIPIENT=name@example.com
PUBLIC_BASE_URL=http://localhost:8000
EMAIL_FROM=name@gmail.com
